# ---- Database ----
DATABASE_URL=jdbc:postgresql://localhost:5432/rke
DB_USERNAME=rke
DB_PASSWORD=rke
POSTGRES_DB=rke

# ---- OpenTelemetry ----
# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable trace export.
# Leave blank to run without a collector (traceId still appears in logs).
# When running via docker compose this is automatically set to http://otel-collector:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=rke-backend
DEPLOYMENT_ENVIRONMENT=development
# Fraction of requests to sample (0.0 = none, 1.0 = all). Use 0.1 in production.
OTEL_SAMPLING_PROBABILITY=1.0

# ---- S3-compatible object storage (logo uploads) ----
# Leave blank to disable logo uploads (backend returns 501).
# For AWS S3: set region, access-key, secret-key, bucket, and public-url-base.
# For Cloudflare R2: set endpoint (https://<accountid>.r2.cloudflarestorage.com),
#   region=auto, and a public-url-base pointing at your R2 custom domain or bucket URL.
# For MinIO (local): endpoint=http://localhost:9000, then bucket/keys as normal.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=rke-assets
S3_PUBLIC_URL_BASE=

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173
