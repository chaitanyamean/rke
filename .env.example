# ---- Database ----
# JDBC URL used by the Spring Boot backend.
# For local (non-docker) runs, point at localhost. Inside docker-compose the
# backend service overrides this to use the "postgres" service hostname.
DATABASE_URL=jdbc:postgresql://localhost:5432/rke
DB_USERNAME=rke
DB_PASSWORD=rke

# Database name created by the postgres container.
POSTGRES_DB=rke
